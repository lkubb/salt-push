Make resource dispatch (salt-call -r) honor returners (--return) and
the local job cache (cache_jobs) — it bypassed caller.py's handling of
both — and render merged state results with the highstate outputter.
Candidate for upstreaming to Salt.

diff --git i/salt/cli/caller.py w/salt/cli/caller.py
index 4d34cd5396..722d5db7a3 100644
--- i/salt/cli/caller.py
+++ w/salt/cli/caller.py
@@ -124,7 +124,45 @@ class BaseCaller:
         Call the module
         """
         if self.opts.get("resources_dispatch"):
-            return self._call_with_resources()
+            def _get_job_ret(ret):
+                job_ret = {
+                    "id": self.opts["id"],
+                    "fun": self.opts["fun"],
+                    "tgt": self.opts.get("resources_tgt", "*"),
+                    "tgt_type": self.opts.get("resources_tgt_type", "glob"),
+                    "jid": salt.utils.jid.gen_jid(self.opts),
+                    "pid": os.getpid(),
+                    "success": True,
+                } | ret
+                metadata = self.opts.get("metadata")
+                if metadata is not None:
+                    metadata = salt.utils.args.yamlify_arg(metadata)
+                if metadata is not None:
+                    job_ret["metadata"] = metadata
